# Copie este archivo a .env:  cp .env.example .env   (Windows: copy .env.example .env)
# Ningún valor requiere cuentas ni servicios de pago.

# ---------- Milvus ----------
# Dentro de Docker la API usa http://milvus:19530 (fijado en docker-compose.yml).
MILVUS_COLLECTION=rag_struct256_e5
MILVUS_INDEX_TYPE=AUTOINDEX

# ---------- Encoder (contrato de la Fase 3) ----------
ENCODER_CONFIG=data/encoder_config.json
EMBEDDING_DEVICE=cpu
# EMBEDDING_MODEL solo para ablaciones: exige otra MILVUS_COLLECTION y reingesta.

# ---------- Ollama / LLM ----------
LLM_MODEL=qwen2.5:1.5b
LLM_MODELS_EXPERIMENT=qwen2.5:1.5b,llama3.2:1b,llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
# Fije la imagen cuando termine el experimento (docker image inspect ollama/ollama --format '{{index .RepoDigests 0}}')
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_GPU_COUNT=1

# ---------- Parámetros RAG por defecto (experimento principal, Fase 5) ----------
PROMPT_VERSION=rag_v5
RETRIEVAL_STRATEGY=diversificada
TOP_K=5
RETRIEVAL_CANDIDATES=30
MAX_CONTEXT_CHARS=6000
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=250

# ---------- Trazabilidad ----------
RUN_LOG_PATH=reports/logs/rag_runs.jsonl
LOG_LEVEL=INFO
FRONTEND_TIMEOUT_SECONDS=330

# ---------- Límites de recursos (CPU en núcleos, memoria en m/g) ----------
# Suma por defecto ≈ 14 GB de techo; el uso real es menor. Ajuste a su equipo.
MILVUS_CPUS=2
MILVUS_MEM=4g
OLLAMA_CPUS=4
OLLAMA_MEM=6g
API_CPUS=2
API_MEM=3g
FRONTEND_CPUS=1
FRONTEND_MEM=512m

# ---------- Red ----------
# 127.0.0.1 = solo accesible desde este equipo. Use 0.0.0.0 para la demo en red local.
BIND_ADDR=127.0.0.1
APP_VERSION=1.0.0
